    {"name":"D52: a notebook the member lists but has not ticked adds nothing to either context","notebookID":"nb1","entries":[{"containerKind":"notebook","containerID":"nb1","itemKind":"source","itemID":"src_a","state":"active","stamps":{"state":"L1759400000000.0000.aaaaaaaa"}},{"containerKind":"notebook","containerID":"nbA","itemKind":"source","itemID":"src_x","state":"active","stamps":{"state":"L1759400000000.0000.aaaaaaaa"}}],"excluded":{},"contextNotebooks":{},"relatedNotebookIDs":{"nbA":true},"expectContextNotebooks":[],"expect":["src_a"],"expectStudio":["src_a"]},
    {"name":"D52: a ticked notebook it lists adds its own active approved sources to the chat, and nothing to the Studio","notebookID":"nb1","entries":[{"containerKind":"notebook","containerID":"nb1","itemKind":"source","itemID":"src_a","state":"active","stamps":{"state":"L1759400000000.0000.aaaaaaaa"}},{"containerKind":"notebook","containerID":"nbA","itemKind":"source","itemID":"src_x","state":"active","stamps":{"state":"L1759400000000.0000.aaaaaaaa"}},{"containerKind":"notebook","containerID":"nbA","itemKind":"source","itemID":"src_p","state":"active","stamps":{"state":"L1759400000000.0000.aaaaaaaa","approval":"L1759400001000.0000.aaaaaaaa"},"approval":"pending"},{"containerKind":"notebook","containerID":"nbA","itemKind":"source","itemID":"src_r","state":"removed","stamps":{"state":"L1759400000000.0000.aaaaaaaa"}}],"excluded":{},"contextNotebooks":{"nbA":true},"relatedNotebookIDs":{"nbA":true},"expectContextNotebooks":["nbA"],"expect":["src_a","src_x"],"expectStudio":["src_a"]},
