  "vectors": "placement",
  "version": 1,
  "spec": "docs/cloudkit-schema-design.md §4.4 (zoneFor), §2.2, §3.5 (each type's zones)",
  "implementations": {
    "swift": "ForeverLMApp/Shared/Sync/Core/ZonePlacement.swift",
