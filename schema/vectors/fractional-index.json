{
  "vectors": "fractional-index",
  "version": 1,
  "spec": "docs/cloudkit-schema-design.md §14.1 (FractionalIndex: rocicorp-compatible base-62 keys)",
  "implementations": {
    "swift": "ForeverLMApp/Shared/Sync/Core/FractionalIndex.swift",
    "js": "schema/js/fractional-index.js"
  },
  "format": "op between: generateKeyBetween(a, b) with null for an open end = expect, or expectError when a key is invalid or a >= b. op nBetween: generateNKeysBetween(a, b, n) = expect. Digits are 0-9A-Za-z (base 62), and a key holding any other character after its head is refused (expectError), which rocicorp's code does not check; keys sort as plain byte strings (never a locale collation), so SQL must compare them with BINARY collation. Expected values are the rocicorp/fractional-indexing algorithm's; the midpoint rounds half up.",
  "cases": [
    {"op":"between","a":null,"b":null,"expect":"a0"},
    {"op":"between","a":null,"b":"a0","expect":"Zz"},
    {"op":"between","a":null,"b":"Zz","expect":"Zy"},
    {"op":"between","a":"a0","b":null,"expect":"a1"},
    {"op":"between","a":"a1","b":null,"expect":"a2"},
    {"op":"between","a":"a0","b":"a1","expect":"a0V"},
    {"op":"between","a":"a1","b":"a2","expect":"a1V"},
    {"op":"between","a":"a0V","b":"a1","expect":"a0l"},
    {"op":"between","a":"Zz","b":"a0","expect":"ZzV"},
    {"op":"between","a":"Zz","b":"a1","expect":"a0"},
    {"op":"between","a":null,"b":"Y00","expect":"Xzzz"},
    {"op":"between","a":"bzz","b":null,"expect":"c000"},
    {"op":"between","a":"a0","b":"a0V","expect":"a0G"},
    {"op":"between","a":"a0","b":"a0G","expect":"a08"},
    {"op":"between","a":"b125","b":"b129","expect":"b127"},
    {"op":"between","a":"a0","b":"a1V","expect":"a1"},
    {"op":"between","a":"Zz","b":"a01","expect":"a0"},
    {"op":"between","a":null,"b":"a0V","expect":"a0"},
    {"op":"between","a":null,"b":"b999","expect":"b99"},
    {"op":"between","a":null,"b":"A000000000000000000000000001","expect":"A000000000000000000000000000V"},
    {"op":"between","a":"zzzzzzzzzzzzzzzzzzzzzzzzzzy","b":null,"expect":"zzzzzzzzzzzzzzzzzzzzzzzzzzz"},
    {"op":"between","a":"zzzzzzzzzzzzzzzzzzzzzzzzzzz","b":null,"expect":"zzzzzzzzzzzzzzzzzzzzzzzzzzzV"},
    {"op":"between","a":null,"b":"A00000000000000000000000000","expectError":true},
    {"op":"between","a":"a00","b":null,"expectError":true},
    {"op":"between","a":"a00","b":"a1","expectError":true},
    {"op":"between","a":"0","b":"1","expectError":true},
    {"op":"between","a":"a1","b":"a0","expectError":true},
    {"op":"between","a":"a1","b":"a1","expectError":true},
    {"op":"nBetween","a":null,"b":null,"n":5,"expect":["a0","a1","a2","a3","a4"]},
    {"op":"nBetween","a":"a4","b":null,"n":10,"expect":["a5","a6","a7","a8","a9","aA","aB","aC","aD","aE"]},
    {"op":"nBetween","a":null,"b":"a0","n":5,"expect":["Zv","Zw","Zx","Zy","Zz"]},
    {"op":"nBetween","a":"a0","b":"a2","n":20,"expect":["a04","a08","a0G","a0K","a0O","a0V","a0Z","a0d","a0l","a0t","a1","a14","a18","a1G","a1O","a1V","a1Z","a1d","a1l","a1t"]},
    {"op":"between","a":"a0-","b":null,"expectError":true},
    {"op":"between","a":null,"b":"a0~","expectError":true},
    {"op":"between","a":"a0 ","b":"a1","expectError":true},
    {"op":"between","a":"a0é","b":null,"expectError":true},
    {"op":"between","a":"a0","b":"a1_","expectError":true},
    {"op":"nBetween","a":"a0.","b":null,"n":3,"expectError":true}
  ]
}
