.env
__pycache__/
*.log
!ForeverLMApp/UnitTests/Fixtures/*.log
.coverage
.venv/

# Build artifacts
*.dmg

# macOS metadata
.DS_Store

# iCloud resolves a sync conflict by keeping both copies, named "Foo 2.ext".
# The repos have been moved out of the synced tree, so these
# should stop appearing — but a stray conflict copy of project.pbxproj that got
# committed would be worse than the drift it came from.
* [0-9].xcodeproj/
* [0-9].pbxproj

# Claude Code
.claude/

# VS Code
.vscode/

# Xcode project bundle: project.pbxproj and shared schemes are generated by
# XcodeGen from project.yml but deliberately committed, so fresh clones build
# without xcodegen and CI can check them for drift. User and workspace state
# stays untracked.
**/*.xcodeproj/**
!**/*.xcodeproj/project.pbxproj
!**/*.xcodeproj/xcshareddata/
!**/*.xcodeproj/xcshareddata/xcschemes/
!**/*.xcodeproj/xcshareddata/xcschemes/*.xcscheme
*.xcworkspace

# Track the SPM resolved-versions pin so dependency versions are reproducible.
# Each parent level must be un-ignored for git to descend to the file.
!**/*.xcodeproj/project.xcworkspace/
!**/*.xcodeproj/project.xcworkspace/xcshareddata/
!**/*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
!**/*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Xcode build artifacts
ForeverLMApp/build/
ForeverLMApp/.build/
docs-site/website/dist/
*.xcarchive
*.xcbuilddata
default.profraw

# Xcode export options (generated)
ExportOptions*.plist

# Generated secrets (contains API keys)
Secrets.generated.swift

# MCP plugin config (contains bearer token)
.mcp.json
!plugins/*/.mcp.json

# Wrangler local state
.wrangler/

# Node modules (everywhere)
node_modules

.git.nosync/

# Local working folders: generated recordings, exports, and personal documents
artifacts/
output/
tmp/
.hop-screenshots/

# The agent rules live in foreverlm-private (linked in by overlay.py).
/AGENTS.md
