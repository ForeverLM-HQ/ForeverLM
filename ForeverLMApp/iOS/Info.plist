<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>ForeverLM</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>ForeverLMAppIdentifierPrefix</key>
	<string>$(AppIdentifierPrefix)</string>
	<key>ForeverLMSyncGeneration</key>
	<string>$(FOREVERLM_SYNC_GENERATION)</string>
	<key>ForeverLMCloudKitEnvironment</key>
	<string>$(FOREVERLM_CLOUDKIT_ENVIRONMENT)</string>
	<key>ForeverLMLibraryContainer</key>
	<string>$(FOREVERLM_CLOUDKIT_CONTAINER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.foreverlm.mobile</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>foreverlm</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Files lists the app's Documents folder as On My iPhone › ForeverLM, where
	     Show in Files puts a paper. Nothing else is kept in Documents, and with no
	     CFBundleDocumentTypes declared, opening in place changes no incoming file. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>AppIcon</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>ForeverLM's voice assistant reads your calendar so it knows your week and day plan when you talk to it, in the app or in CarPlay. It never changes your calendar from the iPhone.</string>
	<key>NSCameraUsageDescription</key>
	<string>ForeverLM uses the camera to scan pages into your library.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>ForeverLM uses the microphone so you can speak instead of typing: when you dictate, when you talk with ForeverLM or about a source in voice mode or CarPlay, and when Siri starts a review.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>ForeverLM turns your speech into text on this device so you can ask questions about what you are reading out loud, and so spoken answers during a review can be graded.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.foreverlm.mobile.memory-review.prepare</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- iPad multitasking is on (no UIRequiresFullScreen), which requires all four
	     orientations or App Store validation warns. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>CKSharingSupported</key>
	<true/>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.foreverlm.studio-notebook</string>
			<key>UTTypeDescription</key>
			<string>Studio Notebook Transfer</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict/>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.foreverlm.studio-goal</string>
			<key>UTTypeDescription</key>
			<string>Studio Goal Transfer</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict/>
		</dict>
	</array>
</dict>
</plist>
