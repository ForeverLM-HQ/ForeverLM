{
  "name": "foreverlm-artifact-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs",
    "e2e": "playwright test -c e2e/playwright.config.mjs",
    "e2e:corpus": "playwright test -c e2e/playwright.config.mjs corpus",
    "e2e:budget": "playwright test -c e2e/playwright.config.mjs typing-budget"
  },
  "dependencies": {
    "@codemirror/language": "6.12.4",
    "@codemirror/view": "6.43.8",
    "@lezer/highlight": "1.2.3",
    "@milkdown/crepe": "7.22.1",
    "@milkdown/kit": "7.22.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2"
  }
}
