# ForeverLM — build-time secrets. Copy this file to `.env` (same directory) and fill in.
# `.env` is gitignored and must NEVER be committed.
#
# NOTE: LLM provider API keys (OpenAI / Anthropic / Groq / etc.) do NOT belong here.
# Provider calls go through the managed ai-proxy worker (server-side / OpenRouter).
#
# Debug builds need NONE of the below — generate_secrets.sh emits empty values.
# Release / DirectDownload / DMG builds require them.

# ForeverLM-owned Google "Desktop" OAuth client for YouTube and, by default, Drive (PKCE-protected).
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# Optional separate desktop client; Drive otherwise uses the client above.
# Its consent screen must allow the read-only Google Drive scope.
DRIVE_OAUTH_CLIENT_ID=
DRIVE_OAUTH_CLIENT_SECRET=

# Notarization via App Store Connect API key (used by scripts/build_dmg.sh).
APPLE_API_KEY_PATH=        # e.g. ~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
APPLE_API_KEY_ID=
APPLE_API_ISSUER_ID=
# The Apple team that signs the app (the DEVELOPMENT_TEAM in
# ForeverLMApp/Signing.local.xcconfig). The key above must belong to it too.
APPLE_TEAM_ID=
